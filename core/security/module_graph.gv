digraph {
  graph [label=":core:security Dependencies", labelloc=t, fontsize=24, ranksep=1.4];
  node [style=filled, fillcolor="#bbdefb", fontname="sans-serif", shape=box, style="rounded,filled"];
  ":core:security" [fillcolor="#9BF6FF"];
  ":core:common" [fillcolor="#9BF6FF"];
  ":core:model" [fillcolor="#9BF6FF"];
  ":core:testing" [fillcolor="#9BF6FF"];
  ":core:domain" [fillcolor="#9BF6FF"];
  ":core:database" [fillcolor="#9BF6FF"];
  ":core:common" -> ":core:model" [color="#1A237E", style=solid]
  ":core:common" -> ":core:testing" [color="#4CAF50", style=dotted, label="implicit"]
  ":core:domain" -> ":core:model" [color="#1A237E", style=solid]
  ":core:domain" -> ":core:common" [color="#1A237E", style=solid]
  ":core:domain" -> ":core:testing" [color="#4CAF50", style=dotted, label="implicit"]
  ":core:model" -> ":core:testing" [color="#4CAF50", style=dotted, label="implicit"]
  ":core:database" -> ":core:model" [color="#1A237E", style=solid]
  ":core:database" -> ":core:domain" [color="#1A237E", style=solid]
  ":core:database" -> ":core:common" [color="#1A237E", style=solid]
  ":core:database" -> ":core:testing" [color="#4CAF50", style=dotted, label="implicit"]
  ":core:security" -> ":core:common" [color="#1A237E", style=solid]
  ":core:security" -> ":core:domain" [color="#1A237E", style=solid]
  ":core:security" -> ":core:model" [color="#1A237E", style=solid]
  ":core:security" -> ":core:testing" [color="#4CAF50", style=dotted, label="implicit"]
  ":core:testing" -> ":core:domain" [color="#1A237E", style=solid]
  ":core:testing" -> ":core:model" [color="#FF9800", style=dashed, label="fixtures"]
  ":core:testing" -> ":core:common" [color="#FF9800", style=dashed, label="fixtures"]
  ":core:testing" -> ":core:domain" [color="#FF9800", style=dashed, label="fixtures"]
  ":core:testing" -> ":core:database" [color="#FF9800", style=dashed, label="fixtures"]
}
