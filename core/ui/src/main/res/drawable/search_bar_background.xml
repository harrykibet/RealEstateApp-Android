<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Rounded corners -->
    <corners android:radius="16dp"/>

    <!-- Background color (white) -->
    <solid android:color="#FFFFFF"/>

    <!-- Optional padding inside the shape -->
    <padding
        android:left="8dp"
        android:right="8dp"
        android:top="8dp"
        android:bottom="8dp"/>

    <!-- Border/Stroke -->
    <stroke
        android:width="1dp"
        android:color="#DDDDDD"/>

    <!-- Shadow-like elevation (works for API 21+) -->
    <elevation android:shadowColor="#000000" android:height="4dp"/>
</shape>
