<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/feature_auth_nav_graph"
    app:startDestination="@id/loginFragment">
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.application.real_estate_app.feature_auth.ui.fragments.LogInFragment"
        android:label="@string/login"
        tools:layout="@layout/fragment_log_in">
        <deepLink
            android:id = "@+id/loginFragmentDeepLink"
            app:uri="https://real_estate_app.com/login"/>
        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.application.real_estate_app.feature_auth.ui.fragments.SignUpFragment"
        android:label="@string/sign_up"
        tools:layout="@layout/fragment_sign_up">
        <deepLink
            android:id = "@+id/signUpFragmentDeepLink"
            app:uri="https://real_estate_app.com/signUp" />
        <action
            android:id="@+id/action_signUpFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
</navigation>