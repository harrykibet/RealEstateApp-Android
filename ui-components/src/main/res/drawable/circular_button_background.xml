<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/white"/> <!-- White color background -->
            <size
                android:width="60dp"
                android:height="60dp" />
            <stroke
                android:width="1dp"
                android:color="#D3D3D3"/> <!-- Optional stroke for a subtle outline -->
        </shape>
    </item>
</selector>
